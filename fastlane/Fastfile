require "json"

# GlassCap — Fastlane for Mac App Store
# Usage: bundle exec fastlane release
# Or: bundle exec fastlane build && bundle exec fastlane deliver_metadata

default_platform(:mac)

platform :mac do
  desc "Build GlassCap.app for release"
  lane :build do
    build_app(
      workspace: nil,
      project: "GlassCap.xcodeproj",
      scheme: "GlassCap",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "GlassCap.app",
      clean: true
    )
  end

  desc "Upload metadata only (no build). Syncs support/privacy/copyright from ENV or APP_STORE_CONFIG, then uploads."
  lane :deliver_metadata do
    project_root = File.expand_path("..", File.dirname(__FILE__))
    sh("ruby \"#{File.join(project_root, 'fastlane', 'scripts', 'sync_metadata_urls.rb')}\"")
    deliver(
      app_identifier: "com.xiaolongou.glasscap",
      platform: "osx",
      username: ENV["FASTLANE_APPLE_ID"] || ENV["DELIVER_USER"],
      team_id: ENV["FASTLANE_TEAM_ID"],
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    api_key_path = File.expand_path("~/.fastlane/api_key.json")
    if File.exist?(api_key_path)
      key_data = JSON.parse(File.read(api_key_path))
      app_store_connect_api_key(
        key_id:      key_data["key_id"],
        issuer_id:   key_data["issuer_id"],
        key_content: key_data["key"],
        duration:    1200,
        in_house:    false
      )
    else
      app_store_connect_api_key(
        key_id:       ENV["ASC_KEY_ID"],
        issuer_id:    ENV["ASC_ISSUER_ID"],
        key_filepath: ENV["ASC_KEY_PATH"],
        in_house:     false
      )
    end
    build_app(
      project: "GlassCap.xcodeproj",
      scheme: "GlassCap",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "GlassCap",
      clean: true,
      export_options: {
        method: "app-store",
        provisioningProfiles: {
          "com.xiaolongou.glasscap" => "GlassCap Mac App Store"
        }
      }
    )
    upload_to_testflight(
      pkg: "./build/GlassCap.pkg",
      app_identifier: "com.xiaolongou.glasscap",
      team_id: ENV["FASTLANE_TEAM_ID"],
      uses_non_exempt_encryption: false,
      skip_waiting_for_build_processing: true
    )

    # Post-upload: poll until VALID, patch export compliance if needed,
    # confirm IN_BETA_TESTING. Exits non-zero if build never becomes distributable.
    build_version = get_info_plist_value(path: "GlassCap/Info.plist", key: "CFBundleVersion")
    sh("python3 ../script/asc-verify-build.py 6757980673 #{build_version}")
  end

  desc "Build and upload to App Store Connect (metadata + .app)"
  lane :release do
    project_root = File.expand_path("..", File.dirname(__FILE__))
    sh("ruby \"#{File.join(project_root, 'fastlane', 'scripts', 'sync_metadata_urls.rb')}\"")
    build
    deliver(
      app_identifier: "com.xiaolongou.glasscap",
      platform: "osx",
      username: ENV["FASTLANE_APPLE_ID"] || ENV["DELIVER_USER"],
      team_id: ENV["FASTLANE_TEAM_ID"],
      skip_screenshots: true,
      force: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false
    )
  end
end

# GlassCap — Fastlane for Mac App Store
# Usage: bundle exec fastlane release
# Or: bundle exec fastlane build && bundle exec fastlane deliver_metadata

default_platform(:mac)

platform :mac do
  desc "Build GlassCap.app for release"
  lane :build do
    build_app(
      workspace: nil,
      project: "GlassCap.xcodeproj",
      scheme: "GlassCap",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "GlassCap.app",
      clean: true
    )
  end

  desc "Upload metadata only (no build). Syncs support/privacy/copyright from ENV or APP_STORE_CONFIG, then uploads."
  lane :deliver_metadata do
    project_root = File.expand_path("..", File.dirname(__FILE__))
    sh("ruby \"#{File.join(project_root, 'fastlane', 'scripts', 'sync_metadata_urls.rb')}\"")
    deliver(
      app_identifier: "com.xiaolongou.glasscap",
      platform: "osx",
      username: ENV["FASTLANE_APPLE_ID"] || ENV["DELIVER_USER"],
      team_id: ENV["FASTLANE_TEAM_ID"],
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Build and upload to App Store Connect (metadata + .app)"
  lane :release do
    project_root = File.expand_path("..", File.dirname(__FILE__))
    sh("ruby \"#{File.join(project_root, 'fastlane', 'scripts', 'sync_metadata_urls.rb')}\"")
    build
    deliver(
      app_identifier: "com.xiaolongou.glasscap",
      platform: "osx",
      username: ENV["FASTLANE_APPLE_ID"] || ENV["DELIVER_USER"],
      team_id: ENV["FASTLANE_TEAM_ID"],
      skip_screenshots: true,
      force: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false
    )
  end
end
